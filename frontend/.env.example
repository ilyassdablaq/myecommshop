# ============================================
# MEDUSA BACKEND CONFIGURATION
# ============================================

# Your Medusa backend URL. Update this to your Railway deployment URL in production.
# Example: https://your-app.railway.app
MEDUSA_BACKEND_URL=http://localhost:9000

# Your publishable API key from Medusa Admin Dashboard
# Find it in: Settings → Apps & Keys → Publishable Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here

# ============================================
# STOREFRONT CONFIGURATION
# ============================================

# Your storefront URL. Used for redirects and links.
# Production: https://your-store.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region (ISO-2 format, lowercase)
# Fallback when user region cannot be determined
NEXT_PUBLIC_DEFAULT_REGION=us

# ============================================
# PAYMENT PROVIDERS
# ============================================

# Stripe public key for card payments
# Get it from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_key_here

# Medusa Payments configuration (if using Medusa Payments provider)
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Analytics (e.g., Google Analytics, Segment)
# NEXT_PUBLIC_ANALYTICS_KEY=

# Feature flags
# NEXT_PUBLIC_FEATURE_FLAG_NAME=true
